# Copia este archivo como .env y rellena las claves. Nunca subas el .env a GitHub.

# Conversación con IA (https://console.anthropic.com → API Keys). Sin clave funciona en modo demo.
ANTHROPIC_API_KEY=
# Opcional: modelo y nivel de razonamiento
# CLAUDE_MODEL=claude-sonnet-5-5
# CLAUDE_EFFORT=low

# Voz natural (https://elevenlabs.io → API Keys). Sin clave usa la voz del navegador.
ELEVENLABS_API_KEY=
# Opcional: voz en español de España (requiere plan de pago), p. ej. Raquel 1eHrpOW5l98cxiSRjbzJ
ELEVENLABS_VOICE_ID=
